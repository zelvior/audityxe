rules_version = '2';

// Audityxe reads/writes Firestore exclusively through the Admin SDK on
// the server (see lib/rate-limit.ts), using a service account that
// bypasses these rules entirely. The client app never talks to
// Firestore directly — only to Firebase Auth. These rules therefore
// deny ALL client-side access by default, which is the correct and
// safest posture: even if a client ever gets a Firestore reference,
// it can't read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
