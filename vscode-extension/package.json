{
  "name": "audityxe",
  "displayName": "Audityxe",
  "description": "Build better. Launch faster. Run a free, unlimited Audityxe website audit (SEO, accessibility, security headers, performance, DNS/TLS) without leaving the editor.",
  "version": "1.0.0",
  "publisher": "zelvior",
  "license": "SEE LICENSE IN https://github.com/zelvior/audityxe/blob/main/LICENSE.md",
  "homepage": "https://audityxe.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelvior/audityxe",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Linters"],
  "keywords": ["audit", "seo", "accessibility", "security", "lighthouse", "website"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "audityxe.auditUrl",
        "title": "Audityxe: Audit a URL",
        "icon": "$(check)"
      },
      {
        "command": "audityxe.auditUrlDeep",
        "title": "Audityxe: Audit a URL (Deep crawl)",
        "icon": "$(search)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
