# ── Audityxe environment configuration ──────────────────────────────
# Copy this file to ".env.local" and fill in real values.
# ".env.local" is gitignored and is what Next.js loads in dev/prod.
#
# ── Getting a FREE Gemini API key ────────────────────────────────────
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with any Google account, click "Create API key".
# 3. The free tier (no billing/card required) covers gemini-2.0-flash
#    and gemini-1.5-flash at generous per-minute/per-day limits — plenty
#    for this app's 3 short JSON-generation calls per audit.
# 4. Paste the key (starts with "AIza...") into GEMINI_API_KEY below.
#    Leave the per-task keys below EMPTY unless you specifically want a
#    different key per task — an empty value is correctly ignored and
#    falls back to the shared key, so you only need to fill in ONE key
#    to enable everything.
#
# IMPORTANT: leave any key you're not using completely EMPTY (not a
# placeholder string like "your_key_here") — a non-empty placeholder
# would otherwise be mistaken for a real (but invalid) key. Audityxe
# does filter out obvious "your_..._here" placeholders automatically,
# but the safest thing is to just leave unused ones blank.
#
# Audityxe calls Gemini for three independent tasks — VERDICT, PROMO,
# and BANNER. Each task tries its own dedicated key(s) FIRST, then
# falls back to the shared GEMINI_API_KEY pool below — both lists are
# merged, so filling in only the shared key is enough to enable all
# three tasks. Any key field also accepts a comma-separated list for
# automatic failover: if a key is invalid, rate-limited (429), or the
# service is overloaded (503), the next one in the list is tried.
#
# If ALL keys for a task fail (or none are configured), that task
# silently falls back to the built-in heuristic generator in
# lib/analyze.ts — the app always returns a full result either way,
# it just won't have AI-written verdict/promo/banner copy.

# ── Shared key (fill this in — enables all 3 AI tasks) ──────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000

# ── Per-task overrides (optional — leave empty to use the shared key) ─
GEMINI_API_KEY_VERDICT=
GEMINI_MODEL_VERDICT=
GEMINI_TIMEOUT_MS_VERDICT=

GEMINI_API_KEY_PROMO=
GEMINI_MODEL_PROMO=
GEMINI_TIMEOUT_MS_PROMO=

GEMINI_API_KEY_BANNER=
GEMINI_MODEL_BANNER=
GEMINI_TIMEOUT_MS_BANNER=

# ── Firebase Admin (server-side, REQUIRED) ─────────────────────────
# Powers auth-token verification, per-account plan lookup, and the
# Firestore-backed daily rate limit. Every /api/audit and /api/account
# request requires these to be set — without them, sign-in still works
# client-side but the API routes will reject all requests with a 500.
# This is entirely free on Firebase's Spark (no-billing) plan for the
# volumes this app produces.
#
# Generate a service account key: Firebase Console → Project settings →
# Service accounts → "Generate new private key" (downloads a JSON file).
FIREBASE_PROJECT_ID=audityxe
FIREBASE_CLIENT_EMAIL=your-service-account@audityxe.iam.gserviceaccount.com
# Paste the "private_key" field from the downloaded JSON, keeping the
# \n sequences literal (this file loads it and converts them at runtime).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── GitHub OAuth App (for "Sign in with GitHub") ────────────────────
# Free. Firebase Auth's GitHub provider needs a GitHub OAuth App.
# Create one at https://github.com/settings/developers → "New OAuth App":
#   Homepage URL:                https://audityxe.vercel.app
#   Authorization callback URL:  https://audityxe.firebaseapp.com/__/auth/handler
# Then paste the Client ID/Secret into BOTH places below:
#   1) Firebase Console → Authentication → Sign-in method → GitHub
#   2) here, for reference/rotation tracking (not read directly by the
#      app at runtime — Firebase handles the OAuth exchange itself once
#      configured in the console).
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── Scheduled cleanup (retention) ───────────────────────────────────
# Free. Protects the account-cleanup cron job (see vercel.json and
# app/api/cron/cleanup-unverified/route.ts) from being triggered by
# anyone who finds the URL. Generate any long random string — e.g.
# `openssl rand -hex 32`. When this env var is set, Vercel Cron
# automatically sends it as `Authorization: Bearer <value>` on every
# scheduled invocation; the route rejects any request without a
# matching header. This job deletes Firebase Auth accounts that were
# created more than 7 days ago and never verified their email — so
# abandoned signups don't accumulate indefinitely, without costing
# anything or requiring a paid backend job runner.
CRON_SECRET=audityxe_secret_cron

# ── Real browser-level auditing (free) ──────────────────────────────
# Optional. Powers the "Browser-Rendered Audit" module, which actually
# renders your page in real Chrome via Google's PageSpeed Insights API
# (the same engine behind Chrome DevTools' Lighthouse panel) instead of
# just parsing HTML. Works with NO key at a modest rate limit — get a
# free key (no billing/card required) at:
# https://developers.google.com/speed/docs/insights/v5/get-started
# for a much higher daily quota.
PAGESPEED_API_KEY=AIzaSyDJGrlBXjCtpNX0bkXRVAUtOjX75qd1Hao
