# =============================================================================
#  AUDITYXE — ENVIRONMENT VARIABLES
# =============================================================================
#  Copy this file to `.env.local` and fill in the values:
#
#      cp .env.example .env.local
#
#  `.env.local` is gitignored. This file (.env.example) is the ONLY env file
#  that should ever be committed — keep it filled with placeholders, never
#  real secrets.
#
#  On Vercel: add each of these under
#      Project → Settings → Environment Variables
#  (NOT by committing a .env file). Redeploy after adding or changing any.
#
#  LEGEND
#      [REQUIRED]  App will not work without it.
#      [OPTIONAL]  Feature degrades gracefully if unset.
#      NEXT_PUBLIC_*  is exposed to the browser. NEVER put a secret behind
#                     that prefix — anything with it is publicly readable.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. FIREBASE — CLIENT (public web config)            [REQUIRED to self-host]
# -----------------------------------------------------------------------------
# These are safe to expose. Firebase scopes access via security rules and
# server-side token verification, not by hiding this config.
#
# WHERE TO GET THEM:
#   1. Go to https://console.firebase.google.com and create a project
#      (or open your existing one).
#   2. Click the gear icon (top-left) → "Project settings".
#   3. Scroll to "Your apps". If there's no web app yet, click the `</>`
#      (Web) icon and register one — any nickname works, Hosting not needed.
#   4. Under "SDK setup and configuration", select "Config".
#   5. Copy each value from the `firebaseConfig` object shown there.
#
# THEN ENABLE SIGN-IN:
#   6. Left sidebar → Build → Authentication → "Get started".
#   7. Sign-in method tab → enable "Email/Password", "Google", and "GitHub".
#      - For GitHub you'll need an OAuth app (see section 2 below).
#   8. Settings tab → "Authorized domains" → add your domain
#      (localhost is already there by default).
#
# ALSO ENABLE FIRESTORE:
#   9. Left sidebar → Build → Firestore Database → "Create database".
#  10. Start in production mode, pick a region close to your users.
#  11. Deploy the rules in this repo: `firebase deploy --only firestore:rules`
#
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# -----------------------------------------------------------------------------
# 2. FIREBASE — ADMIN SDK (server-side, SECRET)                     [REQUIRED]
# -----------------------------------------------------------------------------
# Used server-side to verify auth tokens and read/write Firestore. A leaked
# service account grants FULL read/write on your database and auth — treat
# these as the most sensitive values in this file.
#
# WHERE TO GET THEM:
#   1. Firebase Console → gear icon → "Project settings".
#   2. "Service accounts" tab.
#   3. Click "Generate new private key" → confirm → a JSON file downloads.
#   4. Open that JSON and map the fields:
#        project_id    → FIREBASE_PROJECT_ID
#        client_email  → FIREBASE_CLIENT_EMAIL
#        private_key   → FIREBASE_PRIVATE_KEY
#   5. DELETE the downloaded JSON once copied. Never commit it.
#
# PRIVATE KEY FORMATTING — this trips up almost everyone:
#   The key is multi-line. Keep the literal `\n` escape sequences exactly as
#   they appear in the JSON, and wrap the whole value in double quotes:
#
#     FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
#   On Vercel, paste the key with REAL newlines (not \n) into the value box.
#
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"


# -----------------------------------------------------------------------------
# 3. ENCRYPTION KEY (for user-supplied BYOK API keys)               [REQUIRED]
# -----------------------------------------------------------------------------
# Encrypts the API keys users store in Settings (their own AI key, their own
# PageSpeed Insights key) before they're written to Firestore.
#
# HOW TO GENERATE — run this locally and paste the output:
#
#     openssl rand -hex 32
#
#   ...or without openssl:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: changing this value makes every already-stored user key
# undecryptable. Set it once, keep it backed up, don't rotate casually.
#
BYOK_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# 4. IP HASH SALT (anonymous rate limiting)                         [REQUIRED]
# -----------------------------------------------------------------------------
# Anonymous (logged-out) audits are rate limited per IP. The IP is never
# stored raw — it's hashed with this salt first, so the database holds no
# personally identifying network data.
#
# Generate the same way as above: `openssl rand -hex 32`
#
IP_HASH_SALT=


# -----------------------------------------------------------------------------
# 5. GOOGLE PAGESPEED INSIGHTS API              [OPTIONAL but strongly advised]
# -----------------------------------------------------------------------------
# Powers the Lighthouse Audit module, Core Web Vitals, real-world CrUX field
# data, and the Render Proof screenshot. FREE — no billing account required.
#
# Without a key, PSI falls back to a shared anonymous quota that rate-limits
# aggressively and will fail most of the time in production.
#
# WHERE TO GET IT:
#   1. Go to https://console.cloud.google.com and sign in (a personal Gmail
#      is fine — this does NOT require a paid Google Cloud plan).
#   2. Click the project picker at the top, next to the "Google Cloud" logo.
#   3. Click "New Project" (top-right of the dialog), name it anything,
#      click "Create", then make sure it's selected in the picker.
#   4. Enable the API — go straight to:
#      https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
#      ...and click the blue "Enable" button.
#   5. Go to https://console.cloud.google.com/apis/credentials
#   6. Click "+ Create Credentials" → "API key".
#   7. Copy the key from the popup.
#
#   8. *** CRITICAL — READ THIS OR THE KEY WILL NOT WORK ***
#      Click the key's name → find "Application restrictions" →
#      select "None" → Save.
#
#      WHY: an "HTTP referrers" restriction only validates requests that
#      carry a browser `Referer` header. Audityxe calls PageSpeed Insights
#      SERVER-SIDE, which sends no referrer — so a referrer-restricted key
#      is rejected with a 403 on EVERY request, permanently. An "IP
#      addresses" restriction is also unsafe here, because serverless
#      hosting uses non-fixed outbound IPs. This is enforced by Google's
#      API gateway and cannot be worked around in application code.
#
#      (You can still safely use "API restrictions" → restrict the key to
#      only the PageSpeed Insights API. That's a different setting and is
#      recommended.)
#
PAGESPEED_API_KEY=


# -----------------------------------------------------------------------------
# 6. AI PROVIDER — written verdict & promo copy                     [OPTIONAL]
# -----------------------------------------------------------------------------
# Generates the human-readable verdict and social post copy. The deterministic
# audit engine does NOT depend on this — scores and findings are computed from
# real measurements, never from a model. Without a key, the AI-written prose
# sections are simply omitted; every score still works.
#
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, Together,
# a local llama.cpp/Ollama server, etc.).
#
# WHERE TO GET A KEY:
#   - OpenAI:      https://platform.openai.com/api-keys
#   - OpenRouter:  https://openrouter.ai/keys        (many free models)
#   - Groq:        https://console.groq.com/keys     (free tier, very fast)
#
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000


# -----------------------------------------------------------------------------
# 7. GOOGLE GEMINI — alternative AI provider                        [OPTIONAL]
# -----------------------------------------------------------------------------
# Used as an alternative/fallback to the OpenAI-compatible provider above.
# Gemini has a genuinely usable free tier.
#
# WHERE TO GET IT:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API key" → pick or create a Google Cloud project.
#   3. Copy the key.
#
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000


# -----------------------------------------------------------------------------
# 8. NOWPAYMENTS — crypto checkout                                  [OPTIONAL]
# -----------------------------------------------------------------------------
# Enables paid plan upgrades via cryptocurrency. If NOWPAYMENTS_API_KEY is
# unset, the checkout endpoint returns 503 and the pricing page falls back to
# the manual "pay another way" flow — nothing breaks.
#
# WHERE TO GET THEM:
#   1. Sign up at https://nowpayments.io and complete account setup.
#   2. Add a payout wallet:
#      Dashboard → "Coins settings" / "Payment settings" → add the wallet
#      address you want to be settled to. NOWPayments will not let you
#      create invoices until a payout wallet exists.
#   3. API key:
#      Dashboard → Settings → "Payments" / "API keys" → "Add new key"
#      → copy it into NOWPAYMENTS_API_KEY below.
#   4. IPN secret (REQUIRED if you set the API key — see warning below):
#      Dashboard → Settings → "Instant Payment Notifications"
#      → click "Generate" next to IPN Secret key → copy it.
#   5. IPN callback URL — in that same IPN settings section, set:
#         https://YOUR-DOMAIN.com/api/payments/nowpayments/ipn
#      (Must be a public HTTPS URL. For local testing use a tunnel such as
#       `ngrok http 3000` and use the generated https URL.)
#
# *** SECURITY WARNING ***
#   NOWPAYMENTS_IPN_SECRET is NOT optional once NOWPAYMENTS_API_KEY is set.
#   The IPN webhook verifies every callback with HMAC-SHA512 against this
#   secret. Without it, the handler rejects ALL callbacks (fails closed) —
#   which means payments succeed but plans are never credited. It fails
#   closed on purpose: an unverified webhook would let anyone POST
#   "payment finished" and grant themselves a paid plan for free.
#
# *** SEEING "INVALID_API_KEY" (HTTP 403) WITH A KEY THAT LOOKS RIGHT? ***
#   This exact message covers three different real causes — check all three,
#   in order, before assuming the key itself is wrong:
#     1. API access is a SEPARATE toggle from just having a key.
#        Dashboard → Settings → API → "Enable API access" must be ON.
#     2. No payout wallet configured yet. Invoice creation is blocked until
#        Dashboard → Payment settings has an outcome wallet set.
#     3. A SANDBOX key used against the PRODUCTION API (or the reverse).
#        This integration always calls https://api.nowpayments.io (production).
#        A key generated on a sandbox account will look completely normal and
#        still be rejected — it's valid for a different environment.
#   The app also defensively .trim()s this value, in case a trailing
#   newline snuck in when the key was pasted into Vercel.
#
# *** BEFORE ACCEPTING REAL MONEY ***
#   Run one small real payment end-to-end and confirm the plan is actually
#   credited to the account. Payment integrations cannot be validated by a
#   build passing — only by a real transaction.
#
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=


# NOTE: every field name and endpoint below was cross-checked against
# NOWPayments' own official Node.js SDK, their Postman API reference, and
# their own blog documentation (not just one source) before being wired
# up — specifically because a wrong field name here fails silently in
# ways that are easy to miss until a real customer pays.
#
# --- 8b. NOWPAYMENTS — RECURRING SUBSCRIPTIONS ---------------  [OPTIONAL]
# Enables auto-renewing plans instead of one-off payments. NOWPayments
# emails the customer a payment link now, and a new one a day before each
# period ends — renewals are handled entirely on their side, and every
# resulting payment hits the same IPN webhook (which already credits
# idempotently and stacks paid time).
#
# WHY EMAIL + PASSWORD: unlike the invoice endpoints, every subscription
# endpoint requires a Bearer JWT minted from your dashboard login. That
# JWT lives only ~5 minutes, so it CANNOT be pasted in as a static env
# var — the app mints it on demand from these credentials and caches it.
#
#   Dashboard → Payment tools → Subscriptions → "Create subscription plan"
#   Fill in exactly:
#     Title:            Audityxe Standard   (or: Audityxe Pro)
#     Period duration:  1  Month(s)          <- monthly only, do not change
#     Cost per period:  3  USD  for Standard, 6 USD for Pro
#                        (must match PLANS.standard.priceUsd / PLANS.pro.priceUsd
#                         in lib/plans.ts — that file is the single source of
#                         truth for pricing; keep both in sync if you change it)
#   Under "Advanced settings", set:
#     Payment notifications link:  https://your-domain.com/api/payments/nowpayments/ipn
#     Successful payment page:     https://your-domain.com/payment/status
#     Payment failed page:         https://your-domain.com/pricing?payment=cancelled
#     Partial payment page:        https://your-domain.com/payment/status
#   Copy the resulting Subscription ID into the matching variable below.
#
# Leave the plan IDs unset to keep one-off checkout only.
#
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_PLAN_STANDARD=
NOWPAYMENTS_PLAN_PRO=


# --- 8c. NOWPAYMENTS — DONATION WIDGET ------------------------  [OPTIONAL]
# Embeds the crypto donation widget on /donate.
#
#   Dashboard → Payment tools → Donations → "Widget" tab
#   Copy the `api_key=...` value out of the iframe snippet shown there.
#
# NOTE: this key is PUBLIC by design — it only identifies which merchant
# account a donation goes to, and cannot move funds or read the account.
# That is why it carries the NEXT_PUBLIC_ prefix. Do NOT put your real
# NOWPAYMENTS_API_KEY here; that one is a genuine secret.
#
NEXT_PUBLIC_NOWPAYMENTS_DONATION_KEY=


# --- 8d. PLAN PRICING ------------------------------------------  [OPTIONAL]
# Overrides the USD price of the Standard / Pro plans, used everywhere
# pricing is shown or charged (pricing page, manual email checkout, and
# NOWPayments crypto checkout all read from the same source of truth,
# lib/plans.ts — there is no separate price to keep in sync).
#
# Leave unset to use the defaults: $5 Standard / $6 Pro.
#
# NOTE: these are NEXT_PUBLIC_ vars, so changing them requires a
# redeploy — Next.js inlines NEXT_PUBLIC_* values into the client
# bundle at build time, not per-request.
#
# If you lower NEXT_PUBLIC_STANDARD_PRICE_USD, be aware some
# cryptocurrencies enforce their own minimum invoice amount (varies by
# coin, driven by that coin's network/gas fees) — too low a price can
# make NOWPayments reject the invoice with "Crypto amount ... is less
# than minimal" for that coin. $5 was chosen specifically to clear that
# floor with headroom; going much lower risks reintroducing that error.
#
NEXT_PUBLIC_STANDARD_PRICE_USD=
NEXT_PUBLIC_PRO_PRICE_USD=


# -----------------------------------------------------------------------------
# 9. DONATION / SPONSOR LINK                                        [OPTIONAL]
# -----------------------------------------------------------------------------
# Target for the "Sponsor" button in the footer. Falls back to GitHub Sponsors
# if unset.
#
# Leave unset to use the built-in /donate page (recommended — it embeds
# the donation widget and also lists non-financial ways to help).
# Set it to an external URL to override, e.g. a NOWPayments-hosted
# donation link (Dashboard → Donations → "Link" tab) or GitHub Sponsors.
#
NEXT_PUBLIC_DONATION_URL=


# -----------------------------------------------------------------------------
# 10. ADMIN ACCESS                                                  [OPTIONAL]
# -----------------------------------------------------------------------------
# Grants access to /admin (user management, announcements, redeem codes,
# activity log). Leave unset to disable the admin panel entirely.
#
#   ADMIN_EMAILS    — comma-separated list of account emails allowed in.
#                     These must be real, registered, verified accounts.
#   ADMIN_PASSWORD  — a second factor typed on entry, on top of being signed
#                     in as one of the emails above. Generate a strong one:
#                     `openssl rand -base64 24`
#
# The "Admin Dashboard" link on /account only renders for accounts whose
# email is in ADMIN_EMAILS (checked via a plain boolean the account API
# returns — no password involved in that check, it only decides whether
# the link is shown). It used to render for every signed-in, verified
# account regardless of ADMIN_EMAILS, needlessly advertising the admin
# panel's existence — fixed. The actual gate for /admin's data (email
# allowlist + ADMIN_PASSWORD, both required) was never affected by that
# and is unchanged.
#
ADMIN_EMAILS=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 11. CRON SECRET                                                   [OPTIONAL]
# -----------------------------------------------------------------------------
# Shared secret protecting scheduled maintenance endpoints under /api/cron
# so they can't be triggered by the public.
#
# Generate: `openssl rand -hex 32`
#
# On Vercel, cron jobs defined in vercel.json automatically send this as
# `Authorization: Bearer <CRON_SECRET>` once the variable is set.
#
CRON_SECRET=


# -----------------------------------------------------------------------------
# 12. SEO VERIFICATION                                              [OPTIONAL]
# -----------------------------------------------------------------------------
# Google Search Console site verification token.
#
# WHERE TO GET IT:
#   1. https://search.google.com/search-console → add your property.
#   2. Choose the "HTML tag" verification method.
#   3. Copy ONLY the `content="..."` value — not the whole <meta> tag.
#
GOOGLE_SITE_VERIFICATION=


# -----------------------------------------------------------------------------
# 13. OPERATIONAL KILL SWITCHES                                     [OPTIONAL]
# -----------------------------------------------------------------------------
# Emergency controls. Set the kill switch to "1" to put the whole app into
# maintenance mode without redeploying code (change the env var, redeploy
# config, done).
#
#   AUDITYXE_KILL_SWITCH           — "1" to disable the app entirely.
#   AUDITYXE_KILL_SWITCH_MESSAGE   — message shown while disabled.
#   AUDITYXE_HOTFIX_MESSAGE        — non-blocking banner shown site-wide,
#                                    e.g. during a partial outage.
#
AUDITYXE_KILL_SWITCH=
AUDITYXE_KILL_SWITCH_MESSAGE=
AUDITYXE_HOTFIX_MESSAGE=
